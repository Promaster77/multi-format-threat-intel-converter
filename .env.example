# Copy this file to backend/.env and fill in your real key.
# DO NOT commit backend/.env — it is already in .gitignore.

# MiniMax via OpenRouter (free tier works for testing)
MINIMAX_API_URL=https://openrouter.ai/api/v1/chat/completions
MINIMAX_API_KEY=sk-or-v1-REPLACE_ME
MINIMAX_MODEL=minimax/minimax-m3:free

# Local SQLite file
DATABASE_URL=sqlite:///./sih_demo.db

# Resilience
MAX_RETRIES=2
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
